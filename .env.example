APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://hwa:hwa@localhost:5432/hwa_connect
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-at-least-32-random-characters
TOTP_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
OUTBOX_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=hwa-connect-local
OBJECT_STORAGE_ACCESS_KEY=local-only
OBJECT_STORAGE_SECRET_KEY=local-only-secret
EMAIL_FROM=HWA Connect <admin@hwacconnect.com>
EMAIL_DELIVERY_MODE=log
